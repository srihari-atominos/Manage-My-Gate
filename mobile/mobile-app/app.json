{
  "expo": {
    "name": "Nahom",
    "slug": "atominos",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "mobile-app",
      "managemygate",
      "com.atominosconsulting.nahom",
      "com.googleusercontent.apps.512495714957-ppgtahfr70hmjclhmq7n3c7822aacd41"
    ],
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "enabled": false
    },
    "ios": {
      "deploymentTarget": "16.4",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.atominosconsulting.nahom",
      "buildNumber": "30",
      "associatedDomains": [
        "applinks:nahom.e3esg.com",
        "applinks:app.managemygate.com",
        "applinks:managemygate.e3esg.com"
      ],
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp", "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime", "NSPrivacyAccessedAPITypeReasons": ["35F9.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace", "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"] }
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Nahom requires camera access to scan visitor QR passes and capture photo attachments for maintenance complaints.",
        "NSLocationWhenInUseUsageDescription": "Nahom uses your precise location only when you tap Current Location in your Profile to suggest your city and state, for example Hyderabad, Telangana. Nahom does not use your location for advertising, tracking, or in the background.",
        "NSPhotoLibraryUsageDescription": "Nahom requires photo library access to upload images for amenity bookings and complaint tickets.",
        "LSApplicationQueriesSchemes": [
          "tel",
          "whatsapp"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.atominosconsulting.nahom",
      "googleServicesFile": "./google-services.json",
      "versionCode": 30,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D1015"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "nahom.e3esg.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "app.managemygate.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "managemygate.e3esg.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "nahom.e3esg.com",
              "pathPrefix": "/billing"
            },
            {
              "scheme": "https",
              "host": "app.managemygate.com",
              "pathPrefix": "/billing"
            },
            {
              "scheme": "https",
              "host": "managemygate.e3esg.com",
              "pathPrefix": "/billing"
            },
            {
              "scheme": "https",
              "host": "nahom.e3esg.com",
              "pathPrefix": "/invite/"
            },
            {
              "scheme": "https",
              "host": "app.managemygate.com",
              "pathPrefix": "/invite/"
            },
            {
              "scheme": "https",
              "host": "managemygate.e3esg.com",
              "pathPrefix": "/invite/"
            },
            {
              "scheme": "https",
              "host": "managemygate.e3esg.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "nahom.e3esg.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "app.managemygate.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "managemygate",
              "host": "invite",
              "pathPrefix": "/handoff"
            },
            {
              "scheme": "managemygate",
              "host": "accept-invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D1015"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nahom requires photo library access to upload images for amenity bookings and complaint tickets.",
          "cameraPermission": "Nahom requires camera access to scan visitor QR passes and capture photo attachments for maintenance complaints.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nahom requires camera access to scan visitor QR passes and verify amenity tickets.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF6A00",
          "defaultChannel": "general"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "Nahom uses your contacts only when you choose one, to fill in a visitor's or staff member's name and phone number. Contacts are never uploaded."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94a573d9-5e93-4827-8fbd-605e0ef3a50a"
      }
    },
    "owner": "atominos-consulting-private-limited"
  }
}