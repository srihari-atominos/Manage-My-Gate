{
  "expo": {
    "name": "Nahom",
    "slug": "atominos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile-app",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atominosconsulting.nahom",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "ManageMyGate requires camera access to scan visitor QR passes and capture photo attachments for maintenance complaints.",
        "NSPhotoLibraryUsageDescription": "ManageMyGate requires photo library access to upload images for amenity bookings and complaint tickets.",
        "LSApplicationQueriesSchemes": [
          "tel",
          "whatsapp"
        ]
      }
    },
    "android": {
      "package": "com.atominosconsulting.nahom",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ManageMyGate requires photo library access to upload images for amenity bookings and complaint tickets.",
          "cameraPermission": "ManageMyGate requires camera access to scan visitor QR passes and capture photo attachments for maintenance complaints."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ManageMyGate requires camera access to scan visitor QR passes and verify amenity tickets."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94a573d9-5e93-4827-8fbd-605e0ef3a50a"
      }
    },
    "owner": "atominos-consulting-private-limited"
  }
}
