    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.5.8",
    "axios": "^1.18.1",
    "buffer": "^6.0.3",
    "burnt": "^0.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dijkstrajs": "^1.0.1",
    "expo": "~58.0.21",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.19",
    "expo-auth-session": "~58.0.16",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
