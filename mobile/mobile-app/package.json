    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.0",
    "semver": "^7.8.5",
    "socket.io-client": "^4.8.3",
    "sp-react-native-in-app-updates": "^2.0.0",
    "tailwind-merge": "^3.5.0",
