    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "libphonenumber-js": "^1.13.14",
    "lucide-react-native": "^1.21.0",
    "nativewind": "^4.2.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.82.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
