+export type MainTabKey = 'dashboard' | 'view_all' | 'settings';
+
+interface TabItem {
+  key: MainTabKey;
+  label: string;
+  route: string;
+  icon: React.ComponentType<{ size?: number; color?: string; strokeWidth?: number; style?: any }>;
+}
+
