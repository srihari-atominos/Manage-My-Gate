# Registry Settings
DOCKER_REGISTRY=atocash
IMAGE_TAG=prd1.0

# External Port Configurations
CLIENT_PORT=3005
SERVER_PORT=5007
DB_PORT_EXTERNAL=27019
REDIS_PORT_EXTERNAL=6379

# Database Credentials
MONGO_ROOT_USER=manageadmin
MONGO_ROOT_PASSWORD=ManageAdminPwd@123

# Database Connection URI (Note: @ in password is URL-encoded as %40)
# For Docker Containers (backend -> mongodb):
MONGODB_URI=mongodb://manageadmin:ManageAdminPwd%40123@mongodb:27017/manage_my_gate_prod?replicaSet=rs0&authSource=admin
# For MongoDB Compass via PuTTY SSH Tunnel (Port Forward 27019 -> localhost:27019):
# MONGODB_URI=mongodb://manageadmin:ManageAdminPwd%40123@localhost:27019/manage_my_gate_prod?directConnection=true&authSource=admin

# Redis Cache URI & Tenant Isolation Security Controls (SEC-05)
REDIS_URL=redis://redis:6379
# Enforce strict fail-closed distributed lock enforcement (default false for availability, true in production)
REQUIRE_REDIS_LOCK=false
# Enforce strict fail-closed distributed rate-limiting enforcement (default false for availability, true in production)
REQUIRE_REDIS_RATE_LIMIT=false

# Encryption Keys
JWT_SECRET=f6dd9f23c0dec5698e7f0fc7e0d2f4dbaba4dcd5e58e9935d6ef5ff5d8fc9f9c
SESSION_SECRET=HSGEtCoNdLyEuHCrFOrzFGmyxbkHYLtBbO8QmCYQPxI=
ENCRYPTION_KEY=ysgGTR13/fkLIqmJKRuGmmpzYg2vrzUnqYMg8zIol1g=
# Registry Settings
DOCKER_REGISTRY=atocash
IMAGE_TAG=prd1.0

# External Port Configurations
CLIENT_PORT=3004
SERVER_PORT=5006
DB_PORT_EXTERNAL=27019
REDIS_PORT_EXTERNAL=6379

# Database Credentials
MONGO_ROOT_USER=manageadmin
MONGO_ROOT_PASSWORD=your_mongo_root_password_here

# Database Connection URI (Note: @ in password is URL-encoded as %40)
# For Docker Containers (backend -> mongodb):
MONGODB_URI=mongodb://manageadmin:your_mongo_root_password_here@mongodb:27017/manage_my_gate_prod?replicaSet=rs0&authSource=admin
# For MongoDB Compass via PuTTY SSH Tunnel (Port Forward 27019 -> localhost:27019):
# MONGODB_URI=mongodb://manageadmin:your_mongo_root_password_here@localhost:27019/manage_my_gate_prod?directConnection=true&authSource=admin

# Redis Cache URI
REDIS_URL=redis://redis:6379

# Encryption Keys
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

ALLOWED_ORIGINS=https://your-domain.com

SUPER_ADMIN_EMAIL=admin@enterprise.com
SUPER_ADMIN_PASSWORD=SuperAdminPwd@123

# Billing emails & pay-online links (docs/BILLING_EMAILS.md)
# Public web origin used in invoice email links; must proxy /api to this backend.
# Defaults to https://$MOBILE_UNIVERSAL_LINK_DOMAIN (app.managemygate.com).
# PUBLIC_APP_URL=https://app.managemygate.com
# Fallback Razorpay webhook secret when a community has none in Integration Hub.
# RAZORPAY_WEBHOOK_SECRET=

# Production requires a refresh secret distinct from JWT_SECRET, and JWT_SECRET >= 32 chars
JWT_REFRESH_SECRET=

# Production: separate 32+ char key used to encrypt payment/banking credentials (must differ from ENCRYPTION_KEY)
VAULT_ENCRYPTION_KEY=
# Local development only: allow the mock payment gateway (never set in production)
# ALLOW_MOCK_PAYMENTS=true

# Application Logo URL used in email templates (optional, falls back to https://managemygate.e3esg.com/nahom_full_logo.png)
# APP_LOGO_URL=https://managemygate.e3esg.com/nahom_full_logo.png

# Community Expense receipt OCR (free local Tesseract; no cloud/API key)
EXPENSE_OCR_PROVIDER=tesseract-local
# TESSERACT_COMMAND=tesseract
# EXPENSE_OCR_LANGUAGES=eng
# EXPENSE_OCR_TIMEOUT_MS=20000
# Optional self-hosted structured OCR fallback for table-heavy/scanned receipts
EXPENSE_OCR_OXR_ENABLED=false
# OXR_API_URL=http://localhost:8000/v1/parse/sync
# OXR_API_KEY=
# Personal Expense receipt OCR (free local Tesseract; no cloud/API key)
# Install Tesseract in the backend runtime and verify `tesseract --list-langs`.
PERSONAL_EXPENSE_OCR_PROVIDER=tesseract-local
# TESSERACT_COMMAND=tesseract
# PERSONAL_EXPENSE_OCR_LANGUAGES=eng
# PERSONAL_EXPENSE_OCR_TIMEOUT_MS=20000